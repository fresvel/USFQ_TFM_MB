\contentsline {figure}{\numberline {2}{\ignorespaces Procedimiento de muestreo pasivo con dispositivo tipo torpedo en el pozo de entrada de la PTAR Quitumbe.}}{35}{figure.caption.37}%
\contentsline {figure}{\numberline {3}{\ignorespaces Procedimiento de preconcentración viral mediante precipitación con polietilenglicol (PEG).}}{37}{figure.caption.41}%
